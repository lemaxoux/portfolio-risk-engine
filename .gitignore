# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Environnement virtuel ---
venv/
.venv/
env/

# --- Secrets & configuration locale ---
.env
.env.*
!.env.example

# --- Base de données locale ---
# Les données de marché Tiingo ne sont pas redistribuables : la base ne doit
# jamais être versionnée, même sur un dépôt privé.
data/*.sqlite
data/*.sqlite3
data/*.db
data/*.csv

# --- Tests & qualité ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Documents de cadrage (copie de travail, non versionnée) ---
docs/

# --- Frontend ---
# Même discipline que venv/ : les dépendances ne sont pas versionnées, leurs
# versions exactes le sont (package-lock.json, commité).
frontend/node_modules/
frontend/dist/

# --- Démonstration ---
# Des fichiers produits : `python -m tools.export_demo` écrit le premier
# dossier, `npm run build:demo` le second. La commande et les compositions
# (demo/compositions.json) sont versionnées, pas ce qu'elles écrivent.
demo/export/
frontend/dist-demo/

# --- Éditeurs / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
